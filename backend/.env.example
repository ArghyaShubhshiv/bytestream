# ─── Database (hosted PostgreSQL, e.g. Neon / Supabase / RDS) ────────────────
DATABASE_URL=postgresql://user:password@host:5432/bytestream?schema=public

# ─── Auth ────────────────────────────────────────────────────────────────────
# Use a long random string in production. Required in production.
JWT_SECRET=replace_with_a_long_random_secret

# ─── CORS / URLs ─────────────────────────────────────────────────────────────
# Origin of the deployed frontend (used for CORS).
FRONTEND_URL=https://your-frontend-domain.com
# Public base URL of this backend (no trailing slash).
BACKEND_URL=https://your-backend-domain.com
# Port the server listens on (most hosts inject this automatically).
PORT=3001

# ─── AWS S3 (video uploads) — ALL FOUR are required for uploads to work ───────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_BUCKET_NAME=your_bucket_name

# ─── Code execution (Piston) ─────────────────────────────────────────────────
# URL of your hosted/self-hosted Piston instance.
PISTON_URL=https://your-piston-host:2000
